# Shared by both hubapp (this app) and ragapp (rtfm-rag, imported as a library) —
# both read this same file, so one DATABASE_URL wires them to the same database.
# Port 5433, matching docker-compose.yml (5432 is rtfm-rag's own standalone Postgres).
DATABASE_URL=postgresql://hubapp:hubapp@127.0.0.1:5433/hubapp

# --- ragapp (rtfm-rag) settings — same meaning as in rtfm-rag/.env.example ---
LLM_PROVIDER=ollama

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_KEEP_ALIVE=30m
OLLAMA_CHAT_NUM_CTX=2048
CHAT_MODEL=llama3.2:3b
EMBEDDING_MODEL=nomic-embed-text

# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_CHAT_MODEL=gpt-4o-mini

# ANTHROPIC_API_KEY=
# ANTHROPIC_CHAT_MODEL=claude-haiku-4-5-20251001

CHUNK_SIZE=700
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=5

# --- hubapp (this app) settings ---
# Optional: better manual-discovery search results. Falls back to a keyless
# DuckDuckGo search without one — see docs/specs/03-manual-discovery.md.
# TAVILY_API_KEY=

# Where retained copies of ingested manuals' original PDFs are kept, so they
# can be viewed/downloaded later. Relative paths resolve from wherever the
# backend process is started (normally backend/).
# MANUALS_DIR=data/manuals
